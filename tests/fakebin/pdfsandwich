#!/usr/bin/env bash
# Stand-in for pdfsandwich. Emits the same "Processing page N." lines the real
# one does, so the progress bar is exercised, then copies input to output.
OUT=""
IN=""
while [[ $# -gt 0 ]]; do
	case "$1" in
		-o) OUT="$2"; shift 2 ;;
		-*) shift ;;
		*)  IN="$1"; shift ;;
	esac
done

PAGES=$(pdfinfo "$IN" 2>/dev/null | awk '/^Pages:/{print $2}')
PAGES=${PAGES:-1}
for i in $(seq 1 "$PAGES"); do
	echo "Processing page $i."
done

cp -- "$IN" "$OUT"
