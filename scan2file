_temp_prefix = None
_keep_temp = False

def _cleanup_temp_files():
	if _temp_prefix is None:
		return
	leftovers = glob.glob(_temp_prefix + '*')
	if _keep_temp:
		if leftovers:
			print('Temp files kept: ' + _temp_prefix + '*')
		return
	for f in leftovers:
		try:
			os.remove(f)
		except OSError:
			pass

atexit.register(_cleanup_temp_files)

# Runs magick writing to stdout and stores the bytes ourselves. magick expands
# format specifiers in *output filenames*, so "Rabatt 50%.pdf" would silently
# become "Rabatt 50%-0.pdf". Never hand it a user-controlled output path.
def magick_write(args, target):
	p = Popen(['magick'] + args, stdin=DEVNULL, stdout=PIPE, stderr=PIPE)
	data, err = p.communicate()

	if p.returncode != 0:
		return (p.returncode, err.decode('utf-8', errors='replace').strip())
	if not data:
		return (1, 'magick produced no output')
	try:
		with open(target, 'wb') as out:
			out.write(data)
	except OSError as e:
		return (1, str(e))
	return (0, '')


# Executes given command (argv list), returns (returncode, output as text).
# Uses a list rather than a string so paths containing spaces stay intact.
def run_cmd(cmd, env=None):
	p = Popen(cmd, stdout=PIPE, stdin=PIPE, stderr=PIPE, env=env)
	stdout, stderr = p.communicate()

	if p.returncode == 0:
		return (0, stdout.decode('utf-8', errors='replace'))
	else:
		return (p.returncode, stderr.decode('utf-8', errors='replace').strip())

def extract_pdf_text(pdf_path):
	try:
		rc, out = run_cmd(['pdftotext', pdf_path, '-'])
		if rc == 0:
			return out
	except OSError:
		pass
	return ''

def suggest_filename(pdf_path):
	if not OllamaModel:
		return None
	text = extract_pdf_text(pdf_path).strip()
	if not text:
		print('(pdftotext returned no text — is poppler installed?)')
		return None
	prompt = (
		'Output format: exactly 6-10 lowercase words separated by underscores. '
		'No sentences, no explanation, no punctuation. Only the words.\n'
		'Example output: telekom_rechnung_januar_2026_mobilfunk_vertrag\n\n'
		'Rules:\n'
		'- First word: name of the organization or company the document is from\n'
		'- If it is a letter: use the subject line (Betreff/Re/Betrifft) for the remaining words\n'
		'- Use specific terms (names, amounts, topics), not generic words like "brief" or "dokument"\n'
		'- Use the language of the document\n\n'
		'Document text:\n'
		+ text[:1000] + '\n\n'
		'Output (6-10 words, underscores only):'
	)
	payload = json.dumps({'model': OllamaModel, 'prompt': prompt, 'stream': False}).encode()
	try:
		req = urllib.request.Request(
			'http://localhost:11434/api/generate',
			data=payload,
			headers={'Content-Type': 'application/json'}
		)
		with urllib.request.urlopen(req, timeout=120) as resp:
			raw = json.loads(resp.read()).get('response', '').strip()
			keywords = re.sub(r'[^a-z0-9äöüß]', '_', raw.lower())
			keywords = re.sub(r'_+', '_', keywords).strip('_')
			return keywords if keywords else None
	except Exception as e:
		print('(ollama not reachable: ' + str(e) + ')')
		return None

try:
	from prompt_toolkit import prompt as pt_prompt
	from prompt_toolkit.completion import Completer, Completion
	from prompt_toolkit.validation import Validator, ValidationError as PTValidationError

	class _FileNameCompleter(Completer):
		def __init__(self, directory, ext):
			self.directory = directory
			self.suffix = '.' + ext

		def get_completions(self, document, complete_event):
			text = document.text.lower()
			if not text:
				return
			try:
				entries = sorted(os.listdir(self.directory))
			except OSError:
				return
			for f in entries:
				if not f.lower().endswith(self.suffix):
					continue
				name = f[:-len(self.suffix)]
				if text in name.lower() and name.lower() != text:
					yield Completion(name, start_position=-len(document.text))

	class _FileNameValidator(Validator):
		def __init__(self, directory, ext, ignore=None):
			self.directory = directory
			self.suffix = '.' + ext
			self.ignore = ignore

		def validate(self, document):
			text = document.text.strip()
			if not text:
				return
			name, error = validate_output_name(text)
			if error:
				raise PTValidationError(message=error, cursor_position=len(document.text))
			candidate = os.path.join(self.directory, name + self.suffix)
			if self.ignore and os.path.abspath(candidate) == os.path.abspath(self.ignore):
				return
			if os.path.exists(candidate):
				raise PTValidationError(
					message='"' + name + self.suffix + '" already exists — modify the name',
					cursor_position=len(document.text)
				)

	_has_prompt_toolkit = True
except ImportError:
	_has_prompt_toolkit = False


# Rejects names that would not produce a plain file in the target directory.
def validate_output_name(name):
	name = name.strip()
	if not name:
		return (None, 'Output name must not be empty')
	if os.sep in name or (os.altsep and os.altsep in name):
		return (None, 'Output name must not contain path separators')
	if name in ('.', '..'):
		return (None, 'Invalid output name')
	if name.startswith('-'):
		return (None, 'Output name must not start with "-"')
	return (name, None)


# Removes only a known output extension, so names like "Rechnung 12.03.2026" survive.
def strip_output_ext(name):
	for ext in (SaveFormatOCR, SaveFormatScanOnly, 'pdf'):
		suffix = '.' + ext
		if len(name) > len(suffix) and name.lower().endswith(suffix.lower()):
			return name[:-len(suffix)]
	return name


def ask_filename(message, directory, ext, default='', ignore=None):
	"""Filename prompt with completion and live validation (prompt_toolkit),
	falling back to readline with the same text prefilled."""
	if _has_prompt_toolkit:
		return pt_prompt(
			message,
			completer=_FileNameCompleter(directory, ext),
			validator=_FileNameValidator(directory, ext, ignore=ignore),
			validate_while_typing=True,
			default=default,
		).strip()

	if default:
		readline.set_startup_hook(lambda: readline.insert_text(default))
	try:
		return input(message).strip()
	finally:
		if default:
			readline.set_startup_hook()


def prompt_filename(directory, ext):
	"""Interactive filename prompt before scanning. Returns chosen name (no extension)."""
	fallback = datetime.now().strftime('%Y-%m-%d')
	while True:
		try:
			name = ask_filename('Output filename (without .' + ext + '): ', directory, ext)
		except (KeyboardInterrupt, EOFError):
			sys.exit('\nAborted.')
		if not name:
			return fallback
		name, error = validate_output_name(strip_output_ext(name))
		if error:
			print(error + '.')
			continue
		return name


def llm_rename(current_path):
	"""Post-OCR: ask LLM for a suggestion, then offer a rename prompt."""
	print('Asking LLM for filename suggestion...')
	suggestion = suggest_filename(current_path)
	date_prefix = datetime.now().strftime('%Y-%m-%d')
	prefill = (date_prefix + '_' + suggestion) if suggestion else date_prefix + '_'
	if suggestion:
		print('LLM suggestion: ' + prefill)

	directory = os.path.dirname(current_path) or os.getcwd()
	while True:
		try:
			new_name = ask_filename(
				'Rename (without .' + SaveFormatOCR + ', Enter to keep): ',
				directory, SaveFormatOCR, default=prefill, ignore=current_path)
		except (KeyboardInterrupt, EOFError):
			print('\nKeeping current filename.')
			return current_path

		if not new_name:
			return current_path

		new_name, error = validate_output_name(strip_output_ext(new_name))
		if error:
			print(error + '.')
			continue

		new_path = os.path.join(directory, new_name + '.' + SaveFormatOCR)
		if os.path.abspath(new_path) == os.path.abspath(current_path):
			return current_path
		if os.path.exists(new_path):
			print('"' + new_name + '.' + SaveFormatOCR + '" already exists — choose another name.')
			prefill = new_name
			continue

		os.rename(current_path, new_path)
		return new_path

def find_image_viewer():
	for viewer in ['feh', 'display', 'eog', 'xdg-open']:
		if shutil.which(viewer):
			return viewer
	return None

def show_image(filepath):
	viewer = find_image_viewer()
	if viewer is None:
		return None
	# stdin is closed for the viewer too: it must not swallow keystrokes
	# meant for the prompt behind it.
	if viewer == 'feh':
		return Popen(['feh', '--auto-zoom', '--scale-down', filepath], stdin=DEVNULL)
	if viewer == 'display':
		return Popen(['display', '-resize', '1200x1600>', filepath], stdin=DEVNULL)
	return Popen([viewer, filepath], stdin=DEVNULL)

def close_viewer(proc):
	if proc is None:
		return
	proc.terminate()
	try:
		proc.wait(timeout=2)
	except Exception:
		proc.kill()


# Reads a single keypress without requiring Enter. Returns '' for Enter,
# otherwise the lowercased character. Falls back to line input when stdin
# is not a terminal (pipes, scripted runs).
def read_key(message):
	global _pending_input

	sys.stdout.write(message)
	sys.stdout.flush()

	# Keys typed while the terminal was being probed come first
	if _pending_input:
		char, _pending_input = _pending_input[0], _pending_input[1:]
		if char in ('\r', '\n'):
			print()
			return ''
		print(char)
		return char.lower()

	if not sys.stdin.isatty():
		line = sys.stdin.readline()
		if not line:
			raise EOFError
		answer = line.strip().lower()
		print(answer)
		return answer[:1]

	fd = sys.stdin.fileno()
	old_settings = termios.tcgetattr(fd)
	try:
		tty.setraw(fd, termios.TCSANOW)	# keep type-ahead, see above
		char = sys.stdin.read(1)
	finally:
		termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)

	if char == '\x03':
		raise KeyboardInterrupt
	if char == '\x04':
		raise EOFError
	if char in ('\r', '\n'):
		print()
		return ''
	print(char)
	return char.lower()


## Page overview ##############################################################

# Grayscale ramp, dark to light reversed: index 0 is white paper.
_RAMP = ' .:-=+*#%@'
_graphics_protocol = False	# False = not probed yet, None = none available
_pending_input = ''			# keys typed while the terminal was being probed


# Asks the terminal what it can draw. The kitty graphics query is followed by
# a DA1 request: terminals that ignore the first still answer the second, so
# one round trip covers both protocols.
def detect_graphics_protocol():
	global _pending_input

	if not (sys.stdin.isatty() and sys.stdout.isatty()):
		return None

	query = '\x1b_Gi=31,s=1,v=1,a=q,t=d,f=24;AAAA\x1b\\\x1b[c'
	fd = sys.stdin.fileno()
	try:
		old_settings = termios.tcgetattr(fd)
	except termios.error:
		return None

	response = ''
	try:
		# TCSANOW, not tty.setraw()'s default TCSAFLUSH: flushing would throw
		# away anything the user has already typed ahead.
		tty.setraw(fd, termios.TCSANOW)
		sys.stdout.write(query)
		sys.stdout.flush()
		deadline = time.monotonic() + 0.5
		while time.monotonic() < deadline:
			ready, _, _ = select.select([fd], [], [], 0.1)
			if not ready:
				continue
			chunk = os.read(fd, 256).decode('latin-1')
			if not chunk:
				break
			response += chunk
			if response.endswith('c'):	# DA1 terminator, both answers are in
				break

		# Pick up anything that arrived late, so a stray tail of the reply is
		# not read as the user's next keypress.
		while select.select([fd], [], [], 0.05)[0]:
			chunk = os.read(fd, 256)
			if not chunk:
				break
			response += chunk.decode('latin-1')
	except (OSError, ValueError):
		return None
	finally:
		termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)

	kitty = '_Gi=31;OK' in response
	m = re.search(r'\x1b\[\?([0-9;]*)c', response)
	sixel = bool(m) and '4' in m.group(1).split(';')	# DA1 attribute 4

	# Whatever is not part of the two replies was typed by the user while we
	# were asking. Keep it: discarding it would swallow their keystroke.
	leftover = re.sub(r'\x1b_G[^\x1b]*\x1b\\', '', response)
	leftover = re.sub(r'\x1b\[\?[0-9;]*c', '', leftover)
	_pending_input += leftover

	if kitty:
		return 'kitty'
	if sixel:
		return 'sixels'
	return None


def overview_backend(mode):
	global _graphics_protocol

	if mode == 'off':
		return None
	if mode in ('text', 'window'):
		return mode

	# 'graphics' and 'auto': draw inside the terminal if it can show pixels
	if shutil.which('chafa'):
		if _graphics_protocol is False:
			_graphics_protocol = detect_graphics_protocol()
			if mode == 'graphics' and not _graphics_protocol:
				# Forced: no answer from the terminal, so let chafa decide itself
				_graphics_protocol = 'auto'
		if _graphics_protocol:
			return 'graphics'

	# No graphics protocol (Alacritty, xterm without sixel, ...). A contact
	# sheet in the image viewer still beats character art, and this script
	# opens that viewer for every page anyway. Use --overview text to insist
	# on staying inside the terminal.
	if find_image_viewer():
		return 'window'
	return 'text'


def page_status(page):
	if page.ink is None:
		return '?'
	if page.ink < BlankInkPercent:
		return 'blank?'
	return '%.1f%% ink' % page.ink


# Renders one page as a block of text. Two things matter here:
# the page is fitted and letterboxed rather than stretched, so orientation and
# distortion stay readable (a half-block cell holds 1x2 pixels and displays
# roughly square, so the pixel grid is cols x rows*2); and ink is amplified
# before downscaling, otherwise thin strokes average away against the white
# paper and the thumbnail comes out empty.
def thumbnail_lines(path, cols, rows):
	blank = [' ' * cols] * rows

	p = Popen(['magick', path, '-colorspace', 'Gray',
	           '-resize', '%dx%d' % (cols, rows * 2),
	           '-background', 'white', '-gravity', 'center',
	           '-extent', '%dx%d' % (cols, rows * 2),
	           '-negate', '-evaluate', 'multiply', '3', '-negate',
	           '-depth', '8', 'pgm:-'], stdin=DEVNULL, stdout=PIPE, stderr=PIPE)
	data, _ = p.communicate()
	if p.returncode != 0:
		return blank

	# Binary PGM header: P5 <width> <height> <maxval>, comments start with #
	fields = []
	i = 0
	while len(fields) < 4 and i < len(data):
		while i < len(data) and data[i:i + 1].isspace():
			i += 1
		if data[i:i + 1] == b'#':
			while i < len(data) and data[i:i + 1] != b'\n':
				i += 1
			continue
		j = i
		while j < len(data) and not data[j:j + 1].isspace():
			j += 1
		fields.append(data[i:j])
		i = j
	i += 1	# the single whitespace byte after maxval

	try:
		width, height = int(fields[1]), int(fields[2])
	except (IndexError, ValueError):
		return blank
	raw = data[i:]
	if width <= 0 or height <= 0 or len(raw) < width * height:
		return blank

	scale = len(_RAMP) - 1
	lines = []
	for y in range(0, min(height - 1, rows * 2 - 1), 2):
		lines.append(''.join(
			_RAMP[(255 - ((raw[y * width + x] + raw[(y + 1) * width + x]) // 2)) * scale // 255]
			for x in range(min(width, cols))))
	lines = [line.ljust(cols)[:cols] for line in lines[:rows]]
	return lines + [' ' * cols] * (rows - len(lines))


# Size of the single-page preview, as large as the terminal comfortably allows.
# The box is square-ish so a rotated page is immediately obvious: it fills the
# width instead of the height.
def preview_box_size():
	size = shutil.get_terminal_size((80, 24))
	rows = max(10, min(26, size.lines - 12))
	cols = max(20, min(size.columns - 6, rows * 2))
	return (cols, rows)


# One page as a real inline image, for terminals that can show pixels.
# chafa has no PNM loader, so the page goes through magick as PNG first.
def page_preview_graphics(page, title, protocol):
	cols, rows = preview_box_size()

	chafa = ['chafa', '--animate', 'off', '--size', '%dx%d' % (cols, rows), '-']
	if protocol != 'auto':
		chafa[1:1] = ['-f', protocol]

	print()
	print('  ' + title)
	try:
		builder = Popen(['magick', page.preview, 'png:-'],
		                stdin=DEVNULL, stdout=PIPE, stderr=DEVNULL)
		viewer = Popen(chafa, stdin=builder.stdout)
		builder.stdout.close()
		viewer.wait()
		builder.wait()
	except OSError:
		return False
	if viewer.returncode != 0 or builder.returncode != 0:
		return False
	print()
	return True


# The scanned page drawn straight into the terminal. This replaces the image
# viewer as the default; [v] opens the real thing when a closer look is needed.
def render_page_preview(page, title, mode):
	if (overview_backend(mode) == 'graphics'
			and page_preview_graphics(page, title, _graphics_protocol)):
		return

	cols, rows = preview_box_size()
	lines = thumbnail_lines(page.preview, cols, rows)

	print()
	print('  ┌' + '─' * cols + '┐')
	print('  │' + title.center(cols) + '│')
	print('  ├' + '─' * cols + '┤')
	for line in lines:
		print('  │' + line + '│')
	print('  └' + '─' * cols + '┘')


# Character grid: page thumbnails in boxes, labels stay real text.
def overview_text(pages):
	width = OverviewThumbWidth
	height = OverviewThumbHeight
	columns = shutil.get_terminal_size((80, 24)).columns
	per_row = max(1, (columns - 2) // (width + 4))

	print()
	for start in range(0, len(pages), per_row):
		chunk = pages[start:start + per_row]
		thumbs = [thumbnail_lines(p.preview, width, height) for p in chunk]

		def row(cells):
			return '  ' + '  '.join(cells)

		print(row(['┌' + '─' * width + '┐' for _ in chunk]))
		print(row(['│' + ('Page %d' % (start + i + 1)).center(width) + '│'
		           for i in range(len(chunk))]))
		print(row(['├' + '─' * width + '┤' for _ in chunk]))
		for line in range(height):
			print(row(['│' + t[line] + '│' for t in thumbs]))
		print(row(['├' + '─' * width + '┤' for _ in chunk]))
		print(row(['│' + page_status(p).center(width) + '│' for p in chunk]))
		print(row(['└' + '─' * width + '┘' for _ in chunk]))
		print()
	return True


# Labelled contact sheet of all pages, written to stdout as PNG. It always
# goes to stdout: magick expands '%' in *output filenames*, and the temp
# prefix carries the user's output name.
def montage_command(pages, tile=5):
	cmd = ['magick', 'montage']
	for i, page in enumerate(pages, 1):
		cmd.extend(['-label', 'Page %d\\n%s' % (i, page_status(page)), page.preview])
	cmd.extend(['-tile', '%dx' % min(len(pages), tile), '-geometry', '220x300+8+8',
	            '-background', 'white', '-fill', 'black', '-pointsize', '13',
	            '-bordercolor', 'gray50', '-border', '1',	# white page on white sheet
	            'png:-'])
	return cmd


# Real thumbnails in any terminal: the contact sheet goes to the same image
# viewer the page preview uses. Returns the viewer process, or None.
def overview_window(pages):
	if _temp_prefix is None:
		return None
	sheet = _temp_prefix + '.overview.png'

	builder = Popen(montage_command(pages, tile=4), stdin=DEVNULL, stdout=PIPE, stderr=DEVNULL)
	data, _ = builder.communicate()
	if builder.returncode != 0 or not data:
		return None
	try:
		with open(sheet, 'wb') as out:
			out.write(data)
	except OSError:
		return None
	return show_image(sheet)


# Real inline image: magick builds the labelled contact sheet, chafa draws it
# with whichever graphics protocol the terminal answered with.
def overview_graphics(pages, protocol):
	size = shutil.get_terminal_size((80, 24))

	montage = montage_command(pages)
	chafa = ['chafa', '--animate', 'off',
	         '--size', '%dx%d' % (max(20, size.columns - 2), max(10, size.lines - 6)), '-']
	if protocol != 'auto':
		chafa[1:1] = ['-f', protocol]

	print()
	# montage's stderr goes to DEVNULL on purpose: nobody reads it here, and a
	# pipe nobody drains would deadlock montage once it fills up.
	try:
		builder = Popen(montage, stdin=DEVNULL, stdout=PIPE, stderr=DEVNULL)
		viewer = Popen(chafa, stdin=builder.stdout)
		builder.stdout.close()
		viewer.wait()
		builder.wait()
	except OSError:
		return False
	if viewer.returncode != 0 or builder.returncode != 0:
		return False
	print()
	return True


# Returns None if nothing was shown, a viewer process in window mode, or True
# for the in-terminal paths. Pass the result to close_overview when done.
# Answers "why do I get character art instead of images?" without guesswork.
def report_terminal_capabilities(mode):
	global _graphics_protocol

	chafa = shutil.which('chafa')
	print('Terminal:        TERM=%s, stdout is %s'
	      % (os.environ.get('TERM', '?'),
	         'a terminal' if sys.stdout.isatty() else 'not a terminal'))
	print('chafa:           ' + (chafa or 'not installed'))

	# Probe once and cache it, so the overview_backend() call below reuses it
	if _graphics_protocol is False:
		_graphics_protocol = detect_graphics_protocol()
	protocol = _graphics_protocol
	print('Graphics probe:  ' + (protocol or 'no answer (no kitty protocol, no sixel)'))
	print('Image viewer:    ' + (find_image_viewer() or 'none found'))

	backend = overview_backend(mode)
	print('--overview %-6s selects: %s' % (mode, backend or 'nothing'))
	if backend == 'graphics':
		print('  -> pages and overview are drawn as real images in the terminal')
	elif backend == 'window':
		print('  -> overview opens as a contact sheet in the image viewer')
	elif backend == 'text':
		print('  -> pages and overview are drawn as character art')


def show_overview(pages, mode):
	if not pages:
		return None
	backend = overview_backend(mode)
	if backend is None:
		return None

	if backend == 'window':
		viewer = overview_window(pages)
		if viewer is not None:
			return viewer
		backend = 'text'	# no image viewer around, show it in the terminal
	if backend == 'graphics' and overview_graphics(pages, _graphics_protocol):
		return True

	return True if overview_text(pages) else None


def close_overview(handle):
	if handle is not None and handle is not True:
		close_viewer(handle)


def ask_threshold(current):
	try:
		answer = input('New threshold in %% (1-99, current %d, Enter to keep): ' % current).strip()
	except (KeyboardInterrupt, EOFError):
		print()
		return current
	if not answer:
		return current
	try:
		value = int(answer.rstrip('% '))
	except ValueError:
		print('Not a number.')
		return current
	if not 1 <= value <= 99:
		print('Threshold must be between 1 and 99.')
		return current
	return value


