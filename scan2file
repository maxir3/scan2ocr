# Executes given command, returns stdout/stderr
def execute(cmd, stdin='', env=None):
	cmd = shlex.split(cmd)

	if env is None:
		p = Popen(cmd, stdout=PIPE, stdin=PIPE, stderr=PIPE)
	else:
		p = Popen(cmd, stdout=PIPE, stdin=PIPE, stderr=PIPE, env=env)

	stdout, stderr = p.communicate(stdin)

	if p.returncode == 0:
		return (0, stdout)
	else:
		return (p.returncode, stderr.decode('utf-8', errors='replace'))

# Executes scanimage (sane)
def scan(resolution, width, height, progress, temp_file):
	cmd = ['scanimage', '--format=' + TempFormat, '-d', device,
	       '--resolution', resolution, '-x', width, '-y', height]
	if progress:
		cmd.append('-p')
	cmd.extend(shlex.split(AdditionalScanOptions))

	print('Scanning...')
	try:
		with open(temp_file + '.' + TempFormat, 'wb') as out:
			p = Popen(cmd, stdout=out, stderr=PIPE)
			_, stderr = p.communicate()
		if p.returncode == 0:
			print('Scan done.')
			return True
		else:
			print('Error (exit code %d): %s' % (
				p.returncode, stderr.decode('utf-8', errors='replace').strip()))
			return False
	except OSError as e:
		print('Error: ' + str(e))
		return False

# Optimize Image to black/white, will write a new Temp file
def optimizeImage(bw, temp_file):
	print('Optimization: \t', end='')

	p = execute('magick ' + temp_file + bw + '.' + TempFormat + ' -threshold 65%  ' + temp_file + '.bw.' + TempFormat + '')

	if p[0] != 0:
		raise RuntimeError(p[1])
	print('Done.')

# Convert TempFormat to SaveFormatScanOnly (used when scanning only)
def convertToImage(bw, temp_file, save_file):
	print('Convert: \t', end='')

	p = execute('magick ' + temp_file + bw + '.' + TempFormat + ' ' + save_file + '.' + SaveFormatScanOnly)

	if p[0] != 0:
		raise RuntimeError('Error converting ' + TempFormat + ' to ' + SaveFormatScanOnly + ': ' + p[1])
	print('Done.')

def draw_progress_bar(done, total, width=40):
	if total <= 0:
		return
	fraction = done / total
	filled = int(round(fraction * width))
	bar = '\u2588' * filled + '\u2591' * (width - filled)
	pct = int(fraction * 100)
	sys.stderr.write('\r[%s] %3d%%  (%d/%d)' % (bar, pct, done, total))
	sys.stderr.flush()

# Do ocr on a single image file
def ocr(save, language, temp_file, total_pages=1):
	my_env = os.environ.copy()
	my_env["MALLOC_CHECK_"] = '0'

	if language == 'ger':
		language = 'deu'

	cmd = shlex.split(
		'stdbuf -oL pdfsandwich -nopreproc -layout none -nthreads 1 -lang ' + language
		+ ' -o ' + save + '.pdf ' + temp_file + '.merged.pdf'
	)

	# "Processing page N." appears just before tesseract starts on page N,
	# so page N-1 is complete at that point. We lag by one so 100% means done.
	page_re = re.compile(r'^Processing page (\d+)\.')
	other_lines = []

	sys.stderr.write('OCRing...\n')
	draw_progress_bar(0, total_pages)

	p = Popen(cmd, stdout=PIPE, stderr=STDOUT, env=my_env)

	for raw_line in p.stdout:
		line = raw_line.decode('utf-8', errors='replace').rstrip('\n')
		m = page_re.match(line)
		if m:
			pages_before = int(m.group(1)) - 1
			draw_progress_bar(pages_before, total_pages)
		else:
			other_lines.append(line)

	p.wait()
	draw_progress_bar(total_pages, total_pages)
	sys.stderr.write('\n')

	if p.returncode != 0:
		raise RuntimeError('\n'.join(other_lines))

def print_output_size(filepath):
	try:
		size = os.path.getsize(filepath)
		if size >= 1024 * 1024:
			print('Output: ' + filepath + ' (%.1f MB)' % (size / 1024 / 1024))
		else:
			print('Output: ' + filepath + ' (%.0f KB)' % (size / 1024))
	except OSError:
		pass

# Remove garbage files, if existing
def CleanUp(filename):
	for f in glob.glob(filename + '*.*'):
		os.remove(f)


# Returns True in case the output file already exists.
def OutputFileExists(save_file, mode):
	return (
		(os.path.exists(save_file + '.' + SaveFormatOCR) and mode in ('scanocr', 'ocr'))
		or (os.path.exists(save_file + '.' + SaveFormatScanOnly) and mode == 'scan')
	)


# Main program
def main():
	args = parser.parse_args()

	output_given = args.output is not None

	# Strip any file extension the user may have added (e.g. Foo.pdf -> Foo)
	if output_given:
		args.output = os.path.splitext(args.output)[0]

	# Mode switcher
	print('Current Mode: ', end='')
	if args.mode == 'scanocr':
		print('Scan and OCR')
	elif args.mode == 'scan':
		print('Scan only')
	elif args.mode == 'ocr':
		print('OCR only')
		print('Not yet implemented.')
		sys.exit(0) # For now
	else:
		sys.exit('No valid mode given. Please choose one of: scanocr, scan, ocr')

	print('Device: %s | %sdpi | %sx%smm | %s' % (
		device, args.resolution, args.width, args.height,
		AdditionalScanOptions.strip()))

	if not output_given:
		args.output = os.path.splitext(prompt_filename())[0]

	global _temp_prefix

	# Path and name (random string) of temporary file without extension
	RandomString = ''.join(random.choice(string.ascii_uppercase + string.digits) for x in range(6))
	temp_file = '/tmp/scanner_' + RandomString + args.output
	save_file = os.getcwd() + '/' + args.output
	_temp_prefix = temp_file

	# check if output file exists
	if OutputFileExists(save_file, args.mode):
		sys.exit('Output file exists.')

	try:
		# Create multi-page OCR'ed PDF
		if args.multi:
			page_num = 0
			done = False
			while not done:
				page_num += 1

				# Inner loop: rescan this page if needed
				while True:
					temp_file = _temp_prefix + '_' + str(page_num)
					print('--- Page ' + str(page_num) + ' ---')

					if not scan(args.resolution, args.width, args.height, args.progress, temp_file):
						for f in glob.glob(temp_file + '*'):
							os.remove(f)
						answer = input('Insert document and press Enter to retry (q = abort): ').strip().lower()
						if answer == 'q':
							done = True
							page_num -= 1
							break
						continue  # retry same page

					if args.color:
						preview_file = temp_file + '.' + TempFormat
					else:
						optimizeImage('', temp_file)
						preview_file = temp_file + '.bw.' + TempFormat

					viewer_proc = show_image(preview_file)
					while True:
						answer = input('Page ok? [Enter = next page, n = rescan, r = rotate 90°, q = done]: ').strip().lower()
						if answer == 'r':
							close_viewer(viewer_proc)
							call(['magick', 'mogrify', '-rotate', '90', preview_file])
							viewer_proc = show_image(preview_file)
						else:
							break
					close_viewer(viewer_proc)

					if answer == 'n':
						# Delete temp files for this page and rescan
						for f in glob.glob(temp_file + '*'):
							os.remove(f)
						page_num -= 1  # will be incremented again at top of outer loop
						break
					elif answer == 'q':
						done = True
						break
					else:
						break  # keep page, continue to next

			if page_num == 0:
				sys.exit('No pages scanned.')

			print('Scanned ' + str(page_num) + ' page(s) in total.')

			# ocr or no ocr
			last_temp = _temp_prefix + '_' + str(page_num)
			if args.mode == 'scanocr':
				if args.color:
					page_files = [_temp_prefix + '_' + str(i) + '.' + TempFormat for i in range(1, page_num + 1)]
				else:
					page_files = [_temp_prefix + '_' + str(i) + '.bw.' + TempFormat for i in range(1, page_num + 1)]
				print('Merging %d page(s) into PDF...' % page_num, end='', flush=True)
				ret = call(['magick'] + page_files + [last_temp + '.merged.pdf'])
				if ret != 0:
					print(' Failed.')
					sys.exit('Error: magick merge failed (exit code %d).' % ret)
				print(' Done.')
				ocr(save_file, args.language, last_temp, total_pages=page_num)
			elif args.mode == 'scan':
				if args.color:
					page_files = [_temp_prefix + '_' + str(i) + '.' + TempFormat for i in range(1, page_num + 1)]
				else:
					page_files = [_temp_prefix + '_' + str(i) + '.bw.' + TempFormat for i in range(1, page_num + 1)]
				call(['magick'] + page_files + [save_file + '.' + SaveFormatScanOnly])

			# Clean up temporary files
			CleanUp(_temp_prefix)

			if args.mode == 'scanocr':
				out = save_file + '.' + SaveFormatOCR
				final = llm_rename(out) if args.llm else out
				print_output_size(final)
			elif args.mode == 'scan':
				print_output_size(save_file + '.' + SaveFormatScanOnly)

			sys.exit(0)

		# Normal operation if not in multipage-mode
		while True:
			if not scan(args.resolution, args.width, args.height, args.progress, temp_file):
				for f in glob.glob(temp_file + '*'):
					os.remove(f)
				answer = input('Insert document and press Enter to retry (q = abort): ').strip().lower()
				if answer == 'q':
					sys.exit(1)
				continue

			if args.color:
				preview_file = temp_file + '.' + TempFormat
				blackwhite = ''
			else:
				optimizeImage('', temp_file)
				preview_file = temp_file + '.bw.' + TempFormat
				blackwhite = '.bw'

			viewer_proc = show_image(preview_file)
			while True:
				answer = input('Page ok? [Enter = continue, n = rescan, r = rotate 90°, q = abort]: ').strip().lower()
				if answer == 'r':
					close_viewer(viewer_proc)
					call(['magick', 'mogrify', '-rotate', '90', preview_file])
					viewer_proc = show_image(preview_file)
				else:
					break
			close_viewer(viewer_proc)

			if answer == 'n':
				for f in glob.glob(temp_file + '*'):
					os.remove(f)
				continue
			elif answer == 'q':
				sys.exit(1)
			else:
				break

		# merge to pdf (after preview so rotations are included)
		if args.color:
			call(['magick', temp_file + '.' + TempFormat, temp_file + '.merged.' + SaveFormatOCR])
		else:
			call(['magick', temp_file + '.bw.' + TempFormat, temp_file + '.merged.' + SaveFormatOCR])

		# convert TempFormat to image-format
		if args.mode == 'scan':
			convertToImage(blackwhite, temp_file, save_file)

		# ocr
		if args.mode == 'scanocr':
			ocr(save_file, args.language, temp_file, total_pages=1)

		CleanUp(temp_file)

		if args.mode == 'scanocr':
			out = save_file + '.' + SaveFormatOCR
			final = llm_rename(out) if args.llm else out
			print_output_size(final)
		elif args.mode == 'scan':
			print_output_size(save_file + '.' + SaveFormatScanOnly)

	except RuntimeError as e:
		sys.exit('Error: ' + str(e))

	# End program
	sys.exit(0)


if __name__ == "__main__":
	main()
