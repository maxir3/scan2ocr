# One scanned sheet. The raw scan is never modified; every preview is
# re-rendered from it, so rotation and threshold can be changed at will.
class Page:
	def __init__(self, page_id, prefix):
		self.id = page_id
		self.raw = '%s_%03d.%s' % (prefix, page_id, TempFormat)
		self.preview = '%s_%03d.prep.%s' % (prefix, page_id, TempFormat)
		self.rotation = 0
		self.threshold = Threshold
		self.ink = None

	def remove_files(self):
		for f in (self.raw, self.preview):
			try:
				os.remove(f)
			except OSError:
				pass


# Builds the scanimage options, forcing colour mode when -c is given.
def scan_options(color):
	options = AdditionalScanOptions
	if color:
		if re.search(r'--mode\s+\S+', options):
			options = re.sub(r'--mode\s+\S+', '--mode Color', options)
		else:
			options = (options + ' --mode Color').strip()
	return shlex.split(options)

# Executes scanimage (sane)
def scan(resolution, width, height, progress, target, color=False):
	cmd = ['scanimage', '--format=' + TempFormat, '-d', device,
	       '--resolution', resolution, '-x', width, '-y', height]
	if progress:
		cmd.append('-p')
	cmd.extend(scan_options(color))

	print('Scanning...')
	try:
		with open(target, 'wb') as out:
			p = Popen(cmd, stdin=DEVNULL, stdout=out, stderr=PIPE)
			_, stderr = p.communicate()
		if p.returncode == 0:
			print('Scan done.')
			return True
		else:
			print('Error (exit code %d): %s' % (
				p.returncode, stderr.decode('utf-8', errors='replace').strip()))
			return False
	except OSError as e:
		print('Error: ' + str(e))
		return False


# Renders the preview/output image from the untouched raw scan.
def build_preview(page, args):
	cmd = [page.raw]
	if args.deskew:
		cmd.extend(['-deskew', '40%', '+repage'])
	if not args.color:
		cmd.extend(['-threshold', '%d%%' % page.threshold])
	if args.trim:
		cmd.extend(['-fuzz', '10%', '-trim', '+repage'])
	if page.rotation:
		cmd.extend(['-rotate', str(page.rotation)])
	cmd.append(TempFormat + ':-')

	rc, err = magick_write(cmd, page.preview)
	if rc != 0:
		raise RuntimeError('magick failed on ' + page.raw + ': ' + err)


# Fraction of dark pixels in percent. Measured on a downscaled copy
# (same result, roughly 4x faster) and despeckled to ignore scanner noise.
def ink_coverage(path):
	rc, out = run_cmd(['magick', path, '-resize', '400x', '-despeckle',
	                   '-colorspace', 'Gray', '-format', '%[fx:100*(1-mean)]', 'info:'])
	if rc != 0:
		return None
	try:
		return float(out.strip())
	except ValueError:
		return None


def draw_progress_bar(done, total, width=40):
	if total <= 0:
		return
	fraction = done / total
	filled = int(round(fraction * width))
	bar = '█' * filled + '░' * (width - filled)
	pct = int(fraction * 100)
	sys.stderr.write('\r[%s] %3d%%  (%d/%d)' % (bar, pct, done, total))
	sys.stderr.flush()

# Do ocr on the merged pdf
def ocr(save, language, merged_pdf, total_pages=1):
	my_env = os.environ.copy()
	my_env["MALLOC_CHECK_"] = '0'

	if language == 'ger':
		language = 'deu'

	cmd = ['stdbuf', '-oL', 'pdfsandwich', '-nopreproc', '-layout', 'none',
	       '-nthreads', '1', '-lang', language,
	       '-o', save + '.' + SaveFormatOCR, merged_pdf]

	# "Processing page N." appears just before tesseract starts on page N,
	# so page N-1 is complete at that point. We lag by one so 100% means done.
	page_re = re.compile(r'^Processing page (\d+)\.')
	other_lines = []

	sys.stderr.write('OCRing...\n')
	draw_progress_bar(0, total_pages)

	p = Popen(cmd, stdin=DEVNULL, stdout=PIPE, stderr=STDOUT, env=my_env)

	with p.stdout:
		for raw_line in p.stdout:
			line = raw_line.decode('utf-8', errors='replace').rstrip('\n')
			m = page_re.match(line)
			if m:
				pages_before = int(m.group(1)) - 1
				draw_progress_bar(pages_before, total_pages)
			else:
				other_lines.append(line)

	p.wait()
	draw_progress_bar(total_pages, total_pages)
	sys.stderr.write('\n')

	if p.returncode != 0:
		raise RuntimeError('\n'.join(other_lines))

def print_output_size(filepath):
	try:
		size = os.path.getsize(filepath)
	except OSError as e:
		# Staying silent here once hid a real bug: magick had written the file
		# under a different name than the one we asked for.
		print('Warning: expected output is missing: ' + filepath + ' (' + str(e) + ')')
		return
	if size >= 1024 * 1024:
		print('Output: ' + filepath + ' (%.1f MB)' % (size / 1024 / 1024))
	else:
		print('Output: ' + filepath + ' (%.0f KB)' % (size / 1024))


# Returns True in case the output file already exists.
def OutputFileExists(save_file, mode):
	return (
		(os.path.exists(save_file + '.' + SaveFormatOCR) and mode in ('scanocr', 'ocr'))
		or (os.path.exists(save_file + '.' + SaveFormatScanOnly) and mode == 'scan')
	)


# Scans into page.raw, offering a retry when the scanner reports an error.
# Returns False if the user gave up.
def scan_with_retry(page, args, label):
	while True:
		print('--- ' + label + ' ---')
		if scan(args.resolution, args.width, args.height, args.progress,
		        page.raw, color=args.color):
			return True

		page.remove_files()
		answer = read_key('Insert document and press Enter to retry (q = abort): ')
		if answer == 'q':
			return False


# Shows the page and asks what to do with it. Rotation and threshold are
# applied in place; every other key ends the review.
# Returns 'keep', 'rescan', 'drop', 'back', 'done' or 'abort'.
def review_page(page, args, label, multi, can_go_back=False, pages=None):
	in_terminal = args.overview != 'off'
	dirty = True
	redraw = True
	viewer = None
	# The terminal preview is the default; the viewer only opens on [v].
	# With --overview off there is nothing to look at, so it opens as before.
	want_viewer = not in_terminal
	try:
		while True:
			if dirty:
				close_viewer(viewer)
				viewer = None
				print('Optimization: \t', end='', flush=True)
				build_preview(page, args)
				print('Done.')
				page.ink = ink_coverage(page.preview)
				dirty = False
				redraw = True
				if page.ink is not None and page.ink < BlankInkPercent:
					print('Warning: %s looks blank (%.2f%% ink).' % (label, page.ink))

			if redraw and in_terminal:
				render_page_preview(page, label, args.overview)
			redraw = False

			if viewer is None and want_viewer:
				viewer = show_image(page.preview)

			bits = []
			if page.ink is not None:
				bits.append('%.1f%% ink' % page.ink)
			if not args.color:
				bits.append('thr %d%%' % page.threshold)
			if page.rotation:
				bits.append('rot %d' % page.rotation)
			status = label + (' [' + ', '.join(bits) + ']' if bits else '')

			keys = '[Enter] keep'
			if in_terminal:
				keys += '  [v] view'
			keys += '  [n] rescan  [r] rotate'
			if not args.color:
				keys += '  [t] threshold'
			if multi:
				keys += '  [d] drop'
				if can_go_back:
					keys += '  [b] back'
				if pages and args.overview != 'off':
					keys += '  [o] overview'
				keys += '  [q] done'
			else:
				keys += '  [q] abort'

			answer = read_key(status + '\n' + keys + ': ')

			if answer == 'v' and in_terminal:
				# Open the full-size page and keep it open, so rotating while
				# looking at it still works.
				want_viewer = True
			elif answer == 'r':
				page.rotation = (page.rotation + 90) % 360
				dirty = True
			elif answer == 't' and not args.color:
				close_viewer(viewer)
				viewer = None
				new_threshold = ask_threshold(page.threshold)
				if new_threshold != page.threshold:
					page.threshold = new_threshold
					dirty = True
			elif answer == 'o' and multi and pages and in_terminal:
				# Close the single-page viewer and leave it closed: reopening it
				# would pop right back over the overview the user asked for.
				close_viewer(viewer)
				viewer = None
				want_viewer = False
				handle = show_overview(pages, args.overview)
				if handle is not None:
					read_key('[Enter] back to this page: ')
					close_overview(handle)
				redraw = True	# draw this page again for context
			elif answer == 'b' and multi and can_go_back:
				return 'back'
			elif answer == 'n':
				return 'rescan'
			elif answer == 'd' and multi:
				return 'drop'
			elif answer == 'q':
				return 'done' if multi else 'abort'
			elif answer == '':
				return 'keep'
	finally:
		close_viewer(viewer)


# Walks the already scanned pages starting at start_index, so earlier pages
# can still be rotated, re-thresholded, rescanned or dropped ([b] goes back).
# Returns 'next' (scan another page), 'done' or 'abort'.
def review_stack(pages, start_index, args):
	index = start_index
	while 0 <= index < len(pages):
		page = pages[index]
		label = 'Page %d/%d' % (index + 1, len(pages))
		action = review_page(page, args, label, args.multi,
		                     can_go_back=index > 0, pages=pages)

		if action == 'rescan':
			if scan_with_retry(page, args, label + ' (rescan)'):
				continue
			page.remove_files()
			pages.pop(index)
			return 'done' if pages else 'abort'
		if action == 'drop':
			page.remove_files()
			pages.pop(index)
			print('Page dropped, %d page(s) left.' % len(pages))
			continue	# index now points at the following page, if any
		if action == 'back':
			index -= 1
			continue
		if action == 'abort':
			return 'abort'
		if action == 'done':
			return 'done'
		index += 1	# keep
	return 'next'


# Main program
def main():
	args = parser.parse_args()

	global _temp_prefix, _keep_temp, Threshold
	_keep_temp = args.keep_temp

	if not 1 <= args.threshold <= 99:
		sys.exit('Threshold must be between 1 and 99.')
	Threshold = args.threshold

	if args.probe_terminal:
		report_terminal_capabilities(args.overview)
		sys.exit(0)

	# Mode switcher
	if args.mode == 'ocr':
		sys.exit('OCR only mode is not yet implemented.')
	if args.mode not in ('scanocr', 'scan'):
		sys.exit('No valid mode given. Please choose one of: scanocr, scan, ocr')
	print('Current Mode: ' + ('Scan and OCR' if args.mode == 'scanocr' else 'Scan only'))

	print('Device: %s | %sdpi | %sx%smm | %s' % (
		device, args.resolution, args.width, args.height,
		' '.join(scan_options(args.color))))

	# Ask the terminal what it can draw now, before the first prompt. Doing it
	# mid-flow would send escape sequences while the user may already be typing.
	overview_backend(args.overview)

	work_dir = os.getcwd()
	output_ext = SaveFormatOCR if args.mode == 'scanocr' else SaveFormatScanOnly

	if args.output is None:
		args.output = prompt_filename(work_dir, output_ext)
	else:
		args.output, error = validate_output_name(strip_output_ext(args.output))
		if error:
			sys.exit(error + '.')

	# Path and name (random string) of temporary files without extension
	RandomString = ''.join(random.choice(string.ascii_uppercase + string.digits) for x in range(6))
	_temp_prefix = '/tmp/scanner_' + RandomString + '_' + args.output
	save_file = os.path.join(work_dir, args.output)

	# check if output file exists
	if OutputFileExists(save_file, args.mode):
		sys.exit('Output file exists.')

	pages = []
	next_id = 0

	try:
		while True:
			page = Page(next_id, _temp_prefix)
			next_id += 1

			if not scan_with_retry(page, args, 'Page %d' % (len(pages) + 1)):
				page.remove_files()
				break

			pages.append(page)

			result = review_stack(pages, len(pages) - 1, args)
			if result == 'abort':
				sys.exit(1)
			if result == 'done' or not args.multi:
				break

		if not pages:
			sys.exit('No pages scanned.')

		print('Scanned %d page(s) in total.' % len(pages))

		# Last chance to fix something before the expensive OCR run
		while args.multi and pages:
			handle = show_overview(pages, args.overview)
			if handle is None:
				break
			answer = read_key('[Enter] continue  [e] edit pages  [q] abort: ')
			close_overview(handle)
			if answer == 'q':
				sys.exit(1)
			if answer != 'e':
				break
			if review_stack(pages, 0, args) == 'abort':
				sys.exit(1)
			if not pages:
				sys.exit('No pages left.')

		page_files = [p.preview for p in pages]

		if args.mode == 'scanocr':
			merged = _temp_prefix + '.merged.pdf'
			print('Merging %d page(s) into PDF...' % len(pages), end='', flush=True)
			rc, err = magick_write(page_files + ['pdf:-'], merged)
			if rc != 0:
				print(' Failed.')
				sys.exit('Error: magick merge failed: ' + err)
			print(' Done.')
			ocr(save_file, args.language, merged, total_pages=len(pages))
		elif args.mode == 'scan':
			print('Writing %d page(s)...' % len(pages), end='', flush=True)
			rc, err = magick_write(page_files + [SaveFormatScanOnly + ':-'],
			                       save_file + '.' + SaveFormatScanOnly)
			if rc != 0:
				print(' Failed.')
				sys.exit('Error: magick conversion failed: ' + err)
			print(' Done.')

		if args.mode == 'scanocr':
			out = save_file + '.' + SaveFormatOCR
			final = llm_rename(out) if args.llm else out
			print_output_size(final)
		elif args.mode == 'scan':
			print_output_size(save_file + '.' + SaveFormatScanOnly)

	except RuntimeError as e:
		sys.exit('Error: ' + str(e))
	except KeyboardInterrupt:
		sys.exit('\nAborted.')
	except EOFError:
		sys.exit('\nAborted (no input).')

	# End program
	sys.exit(0)


if __name__ == "__main__":
	main()
